{
  "hooks": {
    "PostToolUse": [{
      "matcher": "Bash|WebFetch",
      "hooks": [{
        "type": "command",
        "command": "jq -f /usr/local/lib/sbxagent/network-block.jq",
        "timeout": 5
      }]
    }],
    "PostToolUseFailure": [{
      "matcher": "Bash|WebFetch",
      "hooks": [{
        "type": "command",
        "command": "jq -f /usr/local/lib/sbxagent/network-block.jq",
        "timeout": 5
      }]
    }]
  }
}
