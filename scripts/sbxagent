#!/usr/bin/env bash
set -euo pipefail

# Upstream virtiofs cache bug: `cp` reading from the mounted workspace inside a
# sandbox writes a hole (correct size, all NUL bytes); `cat` and `dd` are fine.
# https://github.com/docker/sbx-releases/issues/526 — no fix as of sbx v0.39.0.
# Must be set on the host before create. Revisit when bumping the pinned sbx
# version; remove this export once #526 is fixed in that release.
export DOCKER_SANDBOXES_ENABLE_VIRTIOFS_CACHE=0

# One script, three commands. It is installed as a symlink named sbxclaude,
# sbxcodex or sbxcursor, and dispatches on the name it was invoked as. See the
# SELF block below.
SELF="$(basename "$0")"

die() {
	echo "${SELF}: $*" >&2
	exit 1
}

no_args() {
	local command="$1"
	shift
	[[ "$#" -eq 0 ]] || die "'${command}' takes no arguments"
}

usage() {
	cat <<EOF
Usage:
  ${SELF}                    Attach; create first if missing
  ${SELF} name               Print the sandbox name
  ${SELF} version            Print the kit name and version
  ${SELF} exec CMD...        Run a command in the sandbox
  ${SELF} inspect            Show the sandbox state
  ${SELF} create             Create without attaching
  ${SELF} rm                 Remove (destructive; confirms first)
  ${SELF} kit validate       Validate the sandbox kit
  ${SELF} policy log         Show the sandbox policy log
  ${SELF} policy check HOST  Check sandbox network access to HOST
  ${SELF} help               Show this help (-h and --help also work)

This wrapper accepts only the signatures above. Use sbx or ${CLI} directly for
other options, agent prompts and flags, and stop. For direct sbx commands, get
the sandbox name with: S="\$(${SELF} name)"
EOF
}

install_hint() {
	echo "  macOS: brew trust docker/tap && brew install docker/tap/sbx" >&2
	echo "  Linux: curl -fsSL https://get.docker.com | sudo REPO_ONLY=1 sh" >&2
	echo "         sudo apt-get install docker-sbx" >&2
	echo "         sudo usermod -aG kvm \"\${USER}\" && newgrp kvm" >&2
}

# Called from the commands that shell out to sbx, so `name` and `help` work even where sbx is not installed.
require_sbx() {
	if command -v sbx >/dev/null 2>&1; then
		return 0
	fi
	echo "${SELF}: no sbx CLI found in PATH. Install it with:" >&2
	install_hint
	exit 1
}

# Follow symlinks without GNU `readlink -f`: BSD readlink lacked -f before macOS 12.3, and the README installs
# this script as a symlink, so the chain has to be walked to find the kit.
resolve_dir() {
	local path="$1"
	local link
	local hops=0
	while [[ -L "${path}" ]]; do
		((++hops <= 40)) || die "too many symlinks resolving ${1}"
		link="$(readlink "${path}")" || return 1
		case "${link}" in
		/*) path="${link}" ;;
		*) path="$(dirname "${path}")/${link}" ;;
		esac
	done
	(cd "$(dirname "${path}")" && pwd -P)
}

SCRIPT_DIR="$(resolve_dir "${BASH_SOURCE[0]}")"
REPO="$(cd "${SCRIPT_DIR}/.." && pwd -P)"

# Dispatch on the name we were invoked as. SELF is the basename of $0, taken
# before resolve_dir walks the symlink chain — resolving first would erase the
# name the user typed and leave only "sbxagent".
case "${SELF}" in
sbxclaude) CLI="claude" ;;
sbxcodex) CLI="codex" ;;
sbxcursor) CLI="cursor-agent" ;;
*)
	# Covers a direct `./scripts/sbxagent` run and any copy under another name.
	# Deliberately no default agent: silently picking one is worse than failing.
	echo "sbxagent: run this through an agent name, not directly." >&2
	echo "Link it onto your PATH, once per agent you want:" >&2
	echo "  ln -s ${SCRIPT_DIR}/sbxagent ~/.local/bin/sbxclaude   # Claude Code" >&2
	echo "  ln -s ${SCRIPT_DIR}/sbxagent ~/.local/bin/sbxcodex    # Codex" >&2
	echo "  ln -s ${SCRIPT_DIR}/sbxagent ~/.local/bin/sbxcursor   # Cursor" >&2
	echo "Then run sbxclaude, sbxcodex or sbxcursor." >&2
	exit 1
	;;
esac

KIT="${REPO}/kits/${SELF}"
# A name can dispatch before its kit exists (sbxcodex and sbxcursor arrive in
# later stages). Say so here rather than letting sbx fail on a missing path.
[[ -d "${KIT}" ]] || die "no kit directory at ${KIT}"
KIT_NAME="${SELF}" # == spec.yaml name:
DIR="$(pwd -P)"
# Sanitize in pure bash. BSD tr is multibyte-aware while GNU tr is byte oriented, so `tr -c` derived a different
# slug per platform for non-ASCII directory names, and could fail outright with an illegal byte sequence.
SLUG="$(basename "${DIR}")"
SLUG="${SLUG//[!a-zA-Z0-9-]/-}"
while [[ "${SLUG%-}" != "${SLUG}" ]]; do
	SLUG="${SLUG%-}"
done
# Capability probe rather than an OS check, and the pattern to copy for portability: macOS has no sha256sum,
# minimal Linux images have no shasum. Both print "<hex>  -", so cut agrees.
if command -v shasum >/dev/null 2>&1; then
	HASH="$(printf '%s' "${DIR}" | shasum -a 256 | cut -c1-6)"
elif command -v sha256sum >/dev/null 2>&1; then
	HASH="$(printf '%s' "${DIR}" | sha256sum | cut -c1-6)"
else
	die "shasum or sha256sum is required"
fi
SANDBOX="${SELF}-${SLUG:+${SLUG}-}${HASH}"

case "${1:-}" in
"")
	require_sbx
	if sbx inspect "${SANDBOX}" >/dev/null 2>&1; then
		exec sbx run --name "${SANDBOX}"
	fi
	sbx kit validate "${KIT}" >/dev/null
	exec sbx run --name "${SANDBOX}" --kit "${KIT}" "${KIT_NAME}"
	;;
name)
	shift
	no_args name "$@"
	printf '%s\n' "${SANDBOX}"
	;;
version)
	shift
	no_args version "$@"
	kit_version="$(grep -m1 '^version:' "${KIT}/spec.yaml" | grep -oE '[0-9]+\.[0-9]+\.[0-9]+')"
	[[ -n "${kit_version}" ]] || die "could not read version: from ${KIT}/spec.yaml"
	printf '%s %s\n' "${KIT_NAME}" "${kit_version}"
	;;
exec)
	shift
	[[ "$#" -gt 0 ]] || die "'exec' requires CMD"
	[[ "$1" != -* ]] || die "'exec' CMD cannot start with '-'; use sbx directly for exec options"
	require_sbx
	if [[ -t 0 ]]; then
		exec sbx exec -it "${SANDBOX}" -- "$@"
	else
		exec sbx exec -i "${SANDBOX}" -- "$@"
	fi
	;;
inspect)
	shift
	no_args inspect "$@"
	require_sbx
	exec sbx inspect "${SANDBOX}"
	;;
create)
	shift
	no_args create "$@"
	require_sbx
	exec sbx create --name "${SANDBOX}" --kit "${KIT}" "${KIT_NAME}" .
	;;
rm)
	shift
	no_args rm "$@"
	require_sbx
	exec sbx rm "${SANDBOX}"
	;;
kit)
	shift
	case "${1:-}" in
	validate)
		shift
		no_args "kit validate" "$@"
		require_sbx
		exec sbx kit validate "${KIT}"
		;;
	"") die "'kit' requires a subcommand: validate" ;;
	*) die "unknown kit command: $1" ;;
	esac
	;;
policy)
	shift
	case "${1:-}" in
	log)
		shift
		no_args "policy log" "$@"
		require_sbx
		exec sbx policy log "${SANDBOX}"
		;;
	check)
		shift
		[[ "$#" -eq 1 ]] || die "'policy check' requires exactly one HOST"
		require_sbx
		exec sbx policy check network --sandbox "${SANDBOX}" "$1"
		;;
	"") die "'policy' requires a subcommand: log or check" ;;
	*) die "unknown policy command: $1" ;;
	esac
	;;
help | -h | --help)
	shift
	no_args help "$@"
	usage
	;;
*) die "unknown command: $1 (run '${SELF} help' for usage)" ;;
esac
