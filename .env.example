# sbxagent host configuration.
#
# Copy this file to .env (gitignored, never committed) and uncomment or edit
# any line you want to change:
#   cp .env.example .env
#
# Precedence, strongest to weakest:
#   1. a real exported shell environment variable, e.g.
#      HASH_LENGTH=12 sbxclaude name
#   2. this .env file, read once per invocation from the repo root
#   3. scripts/sbxagent's own built-in default
#
# This file is sourced directly as bash, so normal shell syntax works
# (quoting, comments, blank lines). Keep it to plain VAR=value assignments.

# How many hash characters go in generated sandbox and state-directory names.
# Default: 8
#HASH_LENGTH=8

# Whether a sandbox can read the state folders of the other agents' sandboxes
# for this same project (true) or only its own subfolder (false).
# Default: true
#CROSS_SANDBOX_VISIBILITY=true

# false also installs Playwright, Chromium and mmdc (mermaid-cli). Takes
# effect when the sandbox is created.
# Default: true
#SBXAGENT_LITE=true

# Where sbxagent stores its per-project state tree. Must be an absolute path;
# a relative value is treated as unset.
# Default: ~/.local/state
#XDG_STATE_HOME=/absolute/path/to/state/dir
