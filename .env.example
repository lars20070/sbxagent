# sbxagent host configuration.
#
# Copy this file to .env (gitignored, never committed) and uncomment or edit
# any line you want to change:
#   cp .env.example .env
#
# Precedence, strongest to weakest:
#   1. a real exported shell environment variable, e.g.
#      HASH_LENGTH=12 sbxclaude name
#   2. this .env file, read once per invocation from the repo root
#   3. scripts/sbxagent's own built-in default
#
# This file is sourced directly as bash, so normal shell syntax works
# (quoting, comments, blank lines). Keep it to plain VAR=value assignments.

# How many hash characters go in generated sandbox and state-directory names.
# Default: 8
#HASH_LENGTH=8

# Whether a sandbox can read the state folders of the other agents' sandboxes
# for this same project (true) or only its own subfolder (false). Also gates
# the project's shared message board: false mounts no board into a new
# sandbox, but never deletes a board already on the host.
# Default: true
#CROSS_SANDBOX_VISIBILITY=true

# false also installs Playwright, Chromium, mmdc (mermaid-cli) and XeTeX
# (for pandoc PDF output). Takes effect when the sandbox is created.
# Default: true
#SBXAGENT_LITE=true

# false turns the network allow list off: the sandbox can reach any host
# (organisation-policy and local deny rules still apply). Takes effect when
# the sandbox is created.
# Default: true
#NETWORK_ALLOWLIST=true

# true lets the agent use a Chrome browser running on your computer, for
# example to visit sites where you are logged in. On create, the wrapper prints
# two commands for you to run: one to allow the connection, one to start Chrome.
# The agent can do anything in that Chrome, so it runs with its own browser
# profile, one per project and agent, which the wrapper sets up for you. Only
# one sandbox can use host Chrome at a time: a second create fails while the
# first sandbox exists. See docs/host-chrome.md.
# Takes effect when the sandbox is created. Default: false
#HOST_CHROME_ACCESS=false

# Where sbxagent stores its per-project state tree, and the per-project,
# per-agent Chrome profiles for HOST_CHROME_ACCESS. Must be an absolute path;
# a relative value is treated as unset.
# Default: ~/.local/state
#XDG_STATE_HOME=/absolute/path/to/state/dir
